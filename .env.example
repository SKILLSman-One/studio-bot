# Run Setup.cmd / python -m studio_bot setup. Never send tokens/passwords in chat.
BOT_TOKEN=''
# Required for a new installation. Existing installations keep the frozen roster in SQLite.
ADMIN_IDS=''
# PBKDF2 hash, created locally. Keep single quotes to preserve $ in Docker Compose.
ADMIN_PASSWORD_HASH=''
# Optional: unique backup label before startup, e.g. 2026-11-24-before079.
# Requires an existing working SQLite. Same label never overwrites its verified snapshot.
STUDIO_BACKUP_REQUEST=''
# Optional OWNER-ONLY full private ZIP: includes working token/hash, Google key and SQLite.
# Unique label, up to 48 letters/digits/_/-. Output stays private in data/exports/.
STUDIO_EXPORT_REQUEST=''
